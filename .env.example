APP_NAME="africhart-emr"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Comma-separated proxy addresses to trust for X-Forwarded-* headers.
# Leave as the loopback defaults unless a real proxy (e.g. Cloudflare)
# fronts the app. NEVER use '*' — it lets clients forge their own IP
# into the audit log.
TRUSTED_PROXIES=127.0.0.1,::1

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=africhart_emr
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=log
CACHE_STORE=database
FILESYSTEM_DISK=local
# Mail (verification codes, admin + backup notifications) is queued so the front
# desk never waits on SMTP. Requires a running worker:
#   php artisan queue:work --tries=3
# Use `sync` only for local dev where you don't want to run a worker.
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Set true in any environment served over HTTPS.
SESSION_SECURE_COOKIE=false

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# SMTP — used for email verification codes and password-reset links.
# Laravel 11+ reads MAIL_SCHEME (MAIL_ENCRYPTION is ignored). Port 465 = smtps.
# Use MAIL_MAILER=log to stub mail entirely (needs LOG_LEVEL=debug to be readable).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# NOTE: there are no REGISTER_CODE_* values any more. Staff join a clinic through
# an invitation issued in-app by that clinic's admin (or `php artisan clinic:invite`
# for a new clinic's first admin), stored per-tenant and single-use. The old codes
# were one value per role for the WHOLE server, so one leaked code worked at every
# clinic.

# Off-site backup storage (S3-compatible: AWS S3, Backblaze B2, Cloudflare R2, Wasabi).
# Set AWS_ENDPOINT for non-AWS providers; leave BACKUP_OFFSITE_DISK blank to keep
# backups local-only. See docs/backups-and-ops.md.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Backups (spatie/laravel-backup)
BACKUP_OFFSITE_DISK=
# MUST be a valid address or left out entirely — spatie/laravel-backup
# validates it at boot. (config/backup.php now collapses a blank value,
# but set it properly rather than relying on that.)
BACKUP_NOTIFICATION_EMAIL=admin@example.com

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
